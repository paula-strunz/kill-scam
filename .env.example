# Kill Scam — local secrets only. Copy this file to `.env` and fill in what you need.
# Never put real keys in git.

# ----------------------------------------------------------------------------- #
# Required to judge a pasted message
# ----------------------------------------------------------------------------- #
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------------------------------------- #
# Optional: see each check in your own Arize AX space
# Project name in code is always `kill-scam`
# ----------------------------------------------------------------------------- #
ARIZE_API_KEY=
ARIZE_SPACE_ID=

# ----------------------------------------------------------------------------- #
# Optional: Gmail read-only (never send, never write)
# Leave blank to hide Connect Gmail. Paste still works.
# ----------------------------------------------------------------------------- #
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
