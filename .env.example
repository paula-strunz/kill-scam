# Kill Scam — local secrets only. Copy this file to `.env` and fill in what you need.
# Never put real keys in git.

# ----------------------------------------------------------------------------- #
# Gmail read-only (V0 main path). Never send, never delete, never write.
# Leave blank to show “Connect Gmail isn’t set up yet” (app still runs).
# V0 is testing-mode OAuth: Paula + invited family testers only.
# Public-everyone Google verification is out of V0.
# ----------------------------------------------------------------------------- #
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Laptop default is http://localhost:8501
# On Render/Fly set this to the public https URL of the app (must match Google Cloud).
GOOGLE_REDIRECT_URI=

# Set to 1 on a shared host so Gmail tokens stay in the browser session, not on disk.
KILL_SCAM_HOSTED=

# ----------------------------------------------------------------------------- #
# Optional: see each check in your own Arize AX space
# Project name in code is always `kill-scam`
# Missing keys: the app still runs.
# ----------------------------------------------------------------------------- #
ARIZE_API_KEY=
ARIZE_SPACE_ID=

# ----------------------------------------------------------------------------- #
# Optional: unused for the five checks today
# ----------------------------------------------------------------------------- #
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
